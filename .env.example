# Copy to .env and fill in values
SECRET_KEY=your-secret-key-min-32-chars
OPENAI_API_KEY=sk-...optional-for-enhanced-extraction
# Local default:
DATABASE_URL=sqlite+aiosqlite:///./aihr.db
# Docker/PostgreSQL option:
# DATABASE_URL=postgresql+asyncpg://aihr:aihr-dev-password@postgres:5432/aihr
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUDIT_LOG_PATH=audit.log
STORAGE_BACKEND=local
# S3-compatible production settings:
# STORAGE_BACKEND=s3
# S3_BUCKET=aihr-resumes
# S3_REGION=us-east-1
# Add any local network host used to open the frontend, for example:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.6:3000
