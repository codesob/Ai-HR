# Copy to .env. Values here are for local development with `docker compose up --build`.

# development | production. Production refuses to start with a weak SECRET_KEY or SQLite.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
LOG_LEVEL=INFO

# Database (docker compose builds DATABASE_URL from these)
POSTGRES_DB=aihr
POSTGRES_USER=aihr
POSTGRES_PASSWORD=change-me
# Outside compose, e.g. running a service directly:
# DATABASE_URL=postgresql+asyncpg://aihr:change-me@localhost:5432/aihr

# Made-up sample company for showing the product (admin@aihr.demo / demo12345). Off by default.
# SEED_DEMO_DATA=true

# Public URLs
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# One-click sign-in buttons for the sample company (needs SEED_DEMO_DATA=true).
NEXT_PUBLIC_DEMO_MODE=false
# Set true only behind a reverse proxy/load balancer that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Sign-in sessions live in httpOnly cookies. Serve the app and API from the same site
# (e.g. app.example.com + api.example.com) so the browser sends them; Secure is on in production.
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# COOKIE_DOMAIN=             # leave empty unless the cookies must be shared across subdomains

# Rate limits (per client IP per window)
RATE_LIMIT_REQUESTS=120
AUTH_RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Inside Docker, services use the bundled redis/qdrant containers. Set these to use managed ones instead.
# EXTERNAL_REDIS_URL=rediss://default:<password>@<host>:<port>/0
# EXTERNAL_QDRANT_URL=https://<cluster>.cloud.qdrant.io
# QDRANT_API_KEY=

# Resume storage: local volume or S3 (uses the standard AWS credential chain)
STORAGE_BACKEND=local
MAX_UPLOAD_MB=5
# S3_BUCKET=aihr-resumes
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=          # for S3-compatible stores (R2, MinIO)

# Email for invites, password resets, email confirmation and interview notices.
# Docker Compose sends everything to the local Mailpit inbox (http://localhost:8025) unless SMTP_HOST is set.
# Production needs a real provider: password reset and email confirmation depend on it.
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=AI-HR <no-reply@yourdomain.com>

# Optional AI providers. Without them, rule-based scoring and template answers are used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=

# HR agent model (any OpenAI-compatible API with tool calling). Defaults to Groq with GROQ_API_KEY.
# AGENT_LLM_BASE_URL=https://api.groq.com/openai/v1
# AGENT_LLM_API_KEY=
# AGENT_LLM_MODEL=openai/gpt-oss-120b
# Run the agent on every workspace every N minutes (0 = only when asked); screen each new application.
AGENT_SCHEDULE_MINUTES=0
AGENT_SCREEN_NEW_APPLICATIONS=true
# Speech-to-text for video answers, on the same provider as the agent. large-v3 handles Nepali far better than turbo.
TRANSCRIPTION_MODEL=whisper-large-v3
# In-app interview calls are peer-to-peer. Public STUN servers are used by default; people behind strict office or
# mobile firewalls also need a TURN server (self-hosted coturn, or a hosted one), e.g.:
# WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# Vision model that reads scanned PDFs and photos of documents. Defaults to NVIDIA with NVIDIA_API_KEY.
# Free and private alternative: run it locally with Ollama ("ollama pull qwen2.5vl:7b", fits an 8 GB GPU), then:
#   VISION_LLM_BASE_URL=http://host.docker.internal:11434/v1
#   VISION_LLM_MODEL=qwen2.5vl:7b
# Hugging Face works too (https://router.huggingface.co/v1 with a token) but needs paid credits.
# VISION_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# VISION_LLM_API_KEY=
# VISION_LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_RERANKER_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
NVIDIA_API_ENDPOINT=https://ai.api.nvidia.com/v1/retrieval
